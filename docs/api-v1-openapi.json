            "type": "integer"
          },
          "command": {
            "type": "string"
          },
          "exit_code": {
            "nullable": true,
            "type": "integer"
          },
          "finding_count": {
            "type": "integer"
          },
          "finished": {
            "nullable": true,
            "type": "string"
          },
          "full_output_available": {

      "Whoami": {
        "properties": {
          "last_seen_at": {
            "description": "Timestamp recorded for the current successful API authentication.",
            "nullable": true,
            "type": "string"
          },
          "token_created": {
            "nullable": true,
            "type": "string"
          }
        },

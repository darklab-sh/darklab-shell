# VSCode
.vscode/

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Python package build artifacts generated under tools/
tools/*/build/
tools/*/dist/
tools/*/src/*.egg-info/

# Vendor JS files are committed as a fallback for local/docker-compose runs.
# The Dockerfile overwrites them with the latest version at image build time.
# Ignore any other files that may accumulate in the vendor directory.
app/static/js/vendor/*
!app/static/js/vendor/ansi_up.js
!app/static/js/vendor/jspdf.umd.min.js
!app/static/js/vendor/xterm-addon-fit.js
!app/static/js/vendor/xterm.css
!app/static/js/vendor/xterm.js

# Built app bundles are committed so read-only Compose mounts can serve them.
# Regenerate with npm run assets:sync; drift is checked by npm run assets:check.
app/static/build/*
!app/static/build/*.css
!app/static/build/*.br
!app/static/build/*.gz
!app/static/build/*.ico
!app/static/build/*.js
!app/static/build/*.map
!app/static/build/*.ttf
!app/static/build/*.woff2
!app/static/build/manifest.json

# Backup directory
backups/

# Persistent workspaces bind mount, if in use
workspaces/

# Persistent data (SQLite run history — contains user data, should not be committed)
data/

# Optional local config overlay for production/server-specific overrides.
*.local.*
 
# Node / JS tooling
node_modules/
playwright-report/
test-results/

# Environment overrides (copy .env.example → .env and edit locally)
.env

# OS
.DS_Store
Thumbs.db

# Downloaded CI job artifacts
artifacts/

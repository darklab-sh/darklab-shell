# Version control and IDE
.git/
.gitlab/
.vscode/
.claude/

# Python dev artifacts
.venv/
.pytest_cache/
__pycache__/
*.pyc

# Node / JS tooling
node_modules/

# Test output
playwright-report/
test-results/

# Dev-only directories not used by the Dockerfile COPY instructions
tests/
docs/
examples/
assets/
scripts/*
!scripts/container/
!scripts/container/install_go_tool.sh
!scripts/container/patches/
!scripts/container/patches/nuclei-kin-openapi-v0.144.patch
!scripts/container/stage_runtime_source.sh
!scripts/operations/
!scripts/operations/backup_system.py
!scripts/operations/migrate_sqlite_to_postgres.py
!scripts/operations/restore_system.py
config/
data/

# Dev dependency manifests
requirements-dev.txt
package.json
package-lock.json
pyrightconfig.json

# Documentation
*.md

# Compose and environment files
compose*.yaml
compose*.yml
docker-compose*.yaml
docker-compose*.yml
.env*

# Operator-owned configuration must never be baked into a local image build.
*.local.*
**/*.local.*

# Development only. Copy this file to .env when running compose.dev.yaml.
# Production installations receive a separate release-managed .env.example.
APP_PORT=8888
DEV_HOST_BIND_ADDRESS=127.0.0.1

# Optional development services. SQLite remains the default. Add postgres or
# llama to this comma-separated list when you want those sidecars. Set
# DATABASE_BACKEND=postgres with the postgres profile to use its default DSN.
COMPOSE_PROFILES=
POSTGRES_DB=darklab_shell
POSTGRES_USER=darklab
POSTGRES_PASSWORD=darklab_dev_password
DATABASE_BACKEND=sqlite
DATABASE_URL=postgresql://darklab:darklab_dev_password@postgres:5432/darklab_shell

# Optional Files support for development. The default tmpfs workspace is
# disposable; add a development Compose override when testing a bind mount.
# WORKSPACE_ENABLED=true
# WORKSPACE_BACKEND=tmpfs
# WORKSPACE_ROOT=/tmp/darklab_shell-workspaces

# Interactive terminal sessions for approved tools.
# INTERACTIVE_PTY_ENABLED=true

# Capability-backed raw-packet scanning inside the development container.
# RAW_PACKET_SCANNING_ENABLED=true

# Intrusive Assessment actions. Every launch still requires confirmation.
# ASSESSMENT_INTRUSIVE_ACTIONS_ENABLED=true

# Optional development overrides shared with the application runtime.
# WEB_CONCURRENCY=1
# WEB_THREADS=4
# RESTRICTED_COMMAND_INPUT_CIDRS=169.254.169.254/32,10.0.0.0/8
# AI_ENABLED=false
# AI_WORKER_ENABLED=0
# AI_FEATURE_SUMMARY=false
# AI_FEATURE_NEXT_COMMANDS=false
# AI_FEATURE_RUN_SUGGESTIONS=false

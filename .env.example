# Port the app listens on inside the container.
# This file takes precedence over the fallback defaults in docker-compose.yml and Dockerfile.
# APP_PORT=8888

# Production image and host-side publish address. The repository-free Compose
# stack pins an exact release and exposes it on every host interface. Set the
# address to 127.0.0.1 when only a local reverse proxy should reach the app.
DARKLAB_IMAGE=docker.io/darklabsh/darklab-shell:2.6.0-rc.23
HOST_BIND_ADDRESS=0.0.0.0

# Optional features are disabled by default. Uncomment the settings for the
# capabilities you want, then recreate the shell container.

# Persistent personal and team Files in the production stack's ./workspaces directory.
# WORKSPACE_ENABLED=true
# WORKSPACE_BACKEND=volume
# WORKSPACE_ROOT=/workspaces

# Interactive terminal sessions for approved tools. Normal multi-worker
# deployments use the bundled Redis service for PTY coordination.
# INTERACTIVE_PTY_ENABLED=true

# Capability-backed SYN and raw-packet scanning. This does not enable Docker
# privileged mode and remains inactive unless runtime readiness checks pass.
# RAW_PACKET_SCANNING_ENABLED=true

# Comma-separated CIDRs that user-submitted scanner commands cannot target.
# The app rejects obvious literal targets and the container blocks scanner egress.
# RESTRICTED_COMMAND_INPUT_CIDRS=169.254.169.254/32,10.0.0.0/8

# Optional Gunicorn runtime sizing.
# Uncomment to override the entrypoint defaults:
# WEB_CONCURRENCY=4
# WEB_THREADS=4

# Optional Prometheus multiprocess scratch directory.
# PROMETHEUS_MULTIPROC_DIR=/tmp/darklab_shell-prom

# Optional outbound-notification worker toggle. Enabled by default.
# NOTIFICATION_WORKER_ENABLED=1

# Optional scheduled-run worker toggle. Enabled by default.
# SCHEDULER_ENABLED=1

# Optional AI assists and bundled llama.cpp model settings.
# Disabled until AI features are enabled.
# If you also use Postgres, include it in COMPOSE_PROFILES, for example:
# COMPOSE_PROFILES=llama,postgres
# AI_WORKER_ENABLED=0
# AI_ENABLED=false
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://llama:8080
# AI_MODEL=Llama-3.1-8B-Instruct
# AI_API_KEY_SECRET_NAME=
# AI_API_KEY=
# AI_CONNECT_TIMEOUT_SECONDS=5
# AI_TIMEOUT_SECONDS=120
# AI_MAX_INPUT_CHARS=24000
# AI_MAX_OUTPUT_TOKENS=120
# AI_NEXT_COMMANDS_MAX_OUTPUT_TOKENS=180
# AI_MAX_CONCURRENT=1
# AI_MAX_QUEUE_DEPTH=20
# AI_RATE_LIMIT_PER_SESSION_HOUR=5
# AI_RATE_LIMIT_GLOBAL_PER_MINUTE=2
# AI_ALLOW_FULL_OUTPUT=false
# AI_REQUIRE_PRIVATE_BASE_URL=true
# AI_BASE_URL_ALLOWED_CIDRS=
# AI_PROMPT_VERSION_OVERRIDE=
# AI_FEATURE_SUMMARY=false
# AI_FEATURE_NEXT_COMMANDS=false
# AI_FEATURE_RUN_SUGGESTIONS=false
# LLAMA_HF_MODEL=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF:Q4_K_M
# LLAMA_THREADS=8
# LLAMA_CTX_SIZE=2048
# LLAMA_N_PREDICT=180
# LLAMA_PARALLEL=1

# Optional Postgres backend settings. SQLite remains the default. The release
# installer fills the password and URL without enabling Postgres; set the
# backend and add postgres to COMPOSE_PROFILES when you choose it.
# DATABASE_BACKEND=postgres
DATABASE_URL=
# DATABASE_POOL_MIN=1
# DATABASE_POOL_MAX=5
# DATABASE_POSTGRES_JIT=false
# POSTGRES_DB=darklab_shell
# POSTGRES_USER=darklab
POSTGRES_PASSWORD=

# Optional encrypted secrets vault master key.
# Must be base64 for exactly 32 decoded bytes. If unset, the app creates
# /data/.secrets_master_key on first use.
# SECRETS_MASTER_KEY=

# Optional Compose profiles. Leave empty for SQLite without the bundled model.
COMPOSE_PROFILES=
